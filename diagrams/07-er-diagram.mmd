erDiagram
    WabaSession ||--o{ SessionMessage : has
    WabaSession {
        string sessionId
        string accountId PK
        string invokerId
        string phoneNumber
        map sessionData
        OrchestrationDataEntry orchestrationDataEntry
    }
    OrchestrationDataEntry {
