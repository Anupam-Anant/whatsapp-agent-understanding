    SessionMessage {
        string id PK
        string sessionId
        string tenantId
        long timestamp
        enum role
        string content
        list toolCalls
        string toolCallId
        string toolName
        long sequenceNumber
    }
    ConversationField {
        string name
        enum type
        map attributes
    }
